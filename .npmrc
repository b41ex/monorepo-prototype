# Isolated linker, per §4. Each project sees only its own declared dependencies, so the
# root node_modules/@types cannot leak type packages into every project and peer-dependent
# tools resolve the consumer's version rather than the root's. Requires every import to be
# declared — binaries used by scripts included — and scripts to use pnpm run, not npm run.
#
# Set explicitly rather than left to the default. Prototype 2 measured this setting on
# pnpm 10.34.5 and reached 17 of 18 build targets green with every test suite matching its
# own baseline, so this is not a variable to re-open: node-linker=hoisted has been run and
# its remaining failures were the silent kind.
node-linker=isolated

strict-peer-dependencies=false

# Publish target for the workspace scope. The per-component .npmrc files that carried this
# are deleted; without it the target would be inferred from the environment. Nothing in
# this prototype publishes, and the scope is @b41ex, so neither half can reach the real
# Netcracker namespace.
@b41ex:registry=https://npm.pkg.github.com/
registry=https://registry.npmjs.org/

# Matches npm's existing behaviour for this dependency set. Replace with an explicit
# onlyBuiltDependencies allow-list before this leaves prototype status.
dangerously-allow-all-builds=true
