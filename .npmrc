# Isolated linker, per §4. Each project sees only its own declared dependencies, so the
# root node_modules/@types cannot leak type packages into every project and peer-dependent
# tools resolve the consumer's version rather than the root's. Requires every import to be
# declared — binaries used by scripts included — and scripts to use pnpm run, not npm run.
#
# Set explicitly rather than left to the default. Prototype 2 measured this setting on
# pnpm 10.34.5 and reached 17 of 18 build targets green with every test suite matching its
# own baseline, so this is not a variable to re-open: node-linker=hoisted has been run and
# its remaining failures were the silent kind.
node-linker=isolated

strict-peer-dependencies=false

# Publish target for the workspace scope. The per-component .npmrc files that carried this
# are deleted; without it the target would be inferred from the environment. Nothing in
# this prototype publishes, and the scope is @b41ex, so neither half can reach the real
# Netcracker namespace.
@b41ex:registry=https://npm.pkg.github.com/
registry=https://registry.npmjs.org/

# Matches npm's existing behaviour for this dependency set. Replace with an explicit
# onlyBuiltDependencies allow-list before this leaves prototype status.
dangerously-allow-all-builds=true

# `pnpm deploy` is how build-task-consumer's image gets a production node_modules. From
# pnpm 10 it refuses by default on a workspace that does not set inject-workspace-packages:
#
#   ERR_PNPM_DEPLOY_NONINJECTED_WORKSPACE  By default, starting from pnpm v10, we only deploy
#   from workspaces that have "inject-workspace-packages=true" set
#
# pnpm offers three ways forward and this is the middle one, chosen over both others:
#
#   inject-workspace-packages=true  REJECTED. It changes how every internal dependency
#       resolves workspace-wide: a workspace package is hard-linked as a COPY of its files
#       instead of symlinked. Consumers then keep seeing the copy until the next install, so
#       `nx build api-diff` followed by `nx build ui-portal` would compile against stale
#       upstream output. That breaks §13's development loop and §7's cascade rebuild, both of
#       which depend on a fresh upstream `dist` being visible immediately. Far too broad a
#       change to make for one image's packaging step, and it would invalidate the
#       byte-identity comparisons the prototype rests on.
#
#   --legacy at each call site  Works, and was the first choice. Dropped because the deploy
#       command appears in three places — the images job, and twice in
#       build-task-consumer/README.md — and a flag that must be remembered at every call site
#       is the "restated per tool, drifts silently" shape that item 1.9 is named for.
#       Forgetting it gives an error that names inject-workspace-packages, which is the
#       option we deliberately did not take.
#
#   force-legacy-deploy=true  CHOSEN. States the workspace-level fact once, in the file that
#       already carries workspace-level package-manager policy. pnpm confirms it is in effect:
#       "Shared workspace lockfile detected but configuration forces legacy deploy
#       implementation. Packages are copied from the content-addressable store to the virtual
#       store."
#
# Both `--legacy` and this setting are named "legacy" by pnpm, so both should be expected to
# go eventually. The migration path is injected workspace packages, and taking it means first
# measuring what it does to the inner loop above.
force-legacy-deploy=true
