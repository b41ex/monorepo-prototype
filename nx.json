{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.unit-test.ts",
      "!{projectRoot}/**/*.unit-test.tsx",
      "!{projectRoot}/**/test/**/*",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__image_snapshots__/**/*",
      "!{projectRoot}/**/*.stories.ts",
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/.storybook/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/nx.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint:check": {
      "inputs": ["default"],
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "build:showcase": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "screenshot-test": {
      "dependsOn": ["build", "^build"],
      "cache": false
    }
  },
  "defaultBase": "develop"
}
