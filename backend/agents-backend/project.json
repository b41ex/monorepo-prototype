{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agents-backend",
  "projectType": "application",
  "tags": [
    "lang:go"
  ],
  "implicitDependencies": [
    "commons-go"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/agents-backend/qubership-apihub-agents-backend",
        "command": "go build -o ../dist/ ./...",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/agents-backend/qubership-apihub-agents-backend",
        "command": "go test ./...",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "default",
        "^production",
        "goToolchain"
      ]
    }
  }
}
