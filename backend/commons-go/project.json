{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "commons-go",
  "projectType": "library",
  "tags": [
    "lang:go"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "cwd": "backend/commons-go",
        "command": "go build ./...",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/commons-go",
        "command": "go test ./...",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "default",
        "^production",
        "goToolchain"
      ]
    }
  }
}
