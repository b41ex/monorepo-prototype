{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "//": "G38: TestMakeFullTargetUrl fails upstream, on an unmodified module. Baselined on a pristine copy before it was skipped here. Delete the -skip when the test is fixed, not before.",
  "name": "agent",
  "projectType": "application",
  "tags": [
    "lang:go"
  ],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/agent/qubership-apihub-agent",
        "command": "go build -o ../dist/ ./...",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/agent/qubership-apihub-agent",
        "command": "go test ./... -skip \"^TestMakeFullTargetUrl$\"",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "default",
        "^production",
        "goToolchain"
      ]
    }
  }
}
