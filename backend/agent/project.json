{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agent",
  "projectType": "application",
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/agent/qubership-apihub-agent",
        "command": "go build -o ../dist/ ./...",
        "env": { "GOWORK": "off" }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/agent/qubership-apihub-agent",
        "command": "go test ./...",
        "env": { "GOWORK": "off" }
      }
    }
  }
}
