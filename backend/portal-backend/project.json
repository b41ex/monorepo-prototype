{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "//": "G38: TestCreateMaintenanceVacuumCleanupJob and TestValidateObjectErrors fail upstream, with commons-go resolved from the proxy and no replace directive. Baselined before they were skipped here. Delete the -skip when they are fixed, not before.",
  "name": "portal-backend",
  "projectType": "application",
  "tags": [
    "lang:go"
  ],
  "implicitDependencies": [
    "commons-go"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/portal-backend/qubership-apihub-service",
        "command": "go build -o ../dist/ ./...",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "production",
        "^production",
        "goToolchain"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/portal-backend/qubership-apihub-service",
        "command": "go test ./... -skip \"^(TestCreateMaintenanceVacuumCleanupJob|TestValidateObjectErrors)$\"",
        "env": {
          "GOWORK": "off"
        }
      },
      "inputs": [
        "default",
        "^production",
        "goToolchain"
      ]
    }
  }
}
