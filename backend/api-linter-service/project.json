{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api-linter-service",
  "projectType": "application",
  "tags": [
    "lang:go"
  ],
  "implicitDependencies": [
    "commons-go"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/api-linter-service/qubership-api-linter-service",
        "command": "go build -o ../dist/ ./...",
        "env": {
          "GOWORK": "off"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/api-linter-service/qubership-api-linter-service",
        "command": "go test ./...",
        "env": {
          "GOWORK": "off"
        }
      }
    }
  }
}
