{
  "compilerOptions": {
    "target": "es6",
    /* Node runs this server directly, so NodeNext describes it, and it makes the
      previously-implied resolution explicit. No "type": "module" in this package, so
      NodeNext still emits CommonJS require() calls - resolution changes, output does not. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./../",
    "outDir": "./build",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  }
}
