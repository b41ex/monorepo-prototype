{
	"compilerOptions": {
    /* TypeScript 6 defaults "types" to [] rather than every package under typeRoots. */
    "types": ["node"],
		/* moduleResolution stated rather than implied. "module": "Node16" already implies
		   Node16 resolution, so this changes nothing today - but an implied default is the
		   half of item 1.10 that shifts silently between TypeScript 6 and 7 instead of
		   failing where anyone would see it. */
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules", ".vscode-test", "test-resources", "src/ui-test/resources/**", ".test-extensions"],
	"include": ["src", ".eslintrc.json"]
}
